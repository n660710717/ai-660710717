    {
      "cell_type": "code",
      "source": [
        "# ฟังก์ชันสร้าง Positional Encoding (Vaswani et al., 2017)\n",
        "# y = amplitude * np.sin(2 * np.pi * frequency * t)\n",
        "\n",
        "# position ทำหน้าที่เหมือน t (เวลาหรือ index token)\n",
        "# angle_rates ทำหน้าที่เหมือนความถี่ของคลื่นในแต่ละ dim\n",
        "\n",
        "def positional_encoding(position: int, d_model: int) -> np.ndarray:\n",
        "    dims = np.arange(d_model)\n",
        "    angle_rates = 1.0 / np.power(10000.0, (dims // 2) * 2 / d_model)\n",
        "    angles = position * angle_rates\n",
        "    pe = np.zeros(d_model, dtype=np.float64)\n",
        "    pe[0::2] = np.sin(angles[0::2])   # even index → sin\n",
        "    pe[1::2] = np.cos(angles[1::2])   # odd index  → cos\n",
        "    return pe\n",
        "\n",
        "def positional_encoding_matrix(num_tokens: int, d_model: int) -> np.ndarray:\n",
        "    return np.stack([positional_encoding(i, d_model) for i in range(num_tokens)], axis=0)"
      ],
      "metadata": {
        "id": "gI6ZSejM7z9M"
      },
      "execution_count": 24,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def plot_positional_heatmap_plotly(num_tokens=50, d_model=64):\n",
        "    pe_mat = positional_encoding_matrix(num_tokens, d_model)\n",
        "    fig = px.imshow(\n",
        "        pe_mat,\n",
        "        color_continuous_scale=\"RdBu\",\n",
        "        labels=dict(x=\"Dimension\", y=\"Token Position\", color=\"Value (sin/cos)\"),\n",
        "        title=f\"Positional Encoding Heatmap (Tokens 0–{num_tokens-1}, {d_model} dims)\"\n",
        "    )\n",
        "    fig.update_layout(height=500, width=900)\n",
        "    fig.show()\n",
        "\n",
        "plot_positional_heatmap_plotly(num_tokens=20, d_model=10)"
      ],
