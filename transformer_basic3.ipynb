        "id": "DQ-uOdyY7swE"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "frequencies_to_compare = [1.0, 2.0, 3.0]\n",
        "num_rows = len(frequencies_to_compare)\n",
        "\n",
        "fig = make_subplots(rows=num_rows, cols=1, subplot_titles=[f'Sine Wave (Frequency = {freq})' for freq in frequencies_to_compare])\n",
        "\n",
        "# Generate and add sine waves for each frequency\n",
        "for i, freq in enumerate(frequencies_to_compare):\n",
        "    y = amplitude * np.sin(2 * np.pi * freq * t)\n",
        "    fig.add_trace(go.Scatter(x=t, y=y, mode='lines', name=f'Freq = {freq}'),\n",
        "                  row=i + 1, col=1)\n",
        "\n",
        "fig.update_layout(height=300 * num_rows, title_text=\"Comparison of Sine Waves with Different Frequencies\")\n",
        "\n",
        "for i in range(num_rows):\n",
        "    fig.update_yaxes(title_text=\"Amplitude\", row=i + 1, col=1)\n",
        "\n",
        "fig.show()"
      ],
