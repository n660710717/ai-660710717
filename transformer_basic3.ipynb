      "source": [
        "# Generate angles from 0 to 2*pi (หน่วยเรเดียน) มีค่าประมาณ 0 ถึง 6.2831\n",
        "theta = np.linspace(0, 2*np.pi, 1000)\n",
        "\n",
        "# Calculate x and y coordinates for the unit circle\n",
        "x = np.cos(theta)\n",
        "y = np.sin(theta)\n",
        "\n",
        "fig = go.Figure(data=go.Scattergl(\n",
        "    x=x,\n",
        "    y=y,\n",
        "    mode='lines',\n",
        "    hoverinfo='text',\n",
        "    text=[f'x: {xi:.3f}<br>y: {yi:.3f}' for xi, yi in zip(x, y)]\n",
        "))\n",
        "\n",
        "# Set layout for the unit circle\n",
        "fig.update_layout(\n",
        "    title=\"Unit Circle with Cosine (x) and Sine (y) Values\",\n",
        "    xaxis_title=\"X (Cosine)\",\n",
        "    yaxis_title=\"Y (Sine)\",\n",
        "    xaxis=dict(range=[-1.2, 1.2], constrain=\"domain\"),\n",
        "    yaxis=dict(scaleanchor=\"x\", scaleratio=1, range=[-1.2, 1.2]),\n",
        "    hovermode='closest',\n",
        "    width=600,\n",
        "    height=600,\n",
        ")\n",
        "\n",
        "fig.add_shape(type=\"circle\",\n",
        "    xref=\"x\", yref=\"y\",\n",
        "    x0=-1, y0=-1, x1=1, y1=1,\n",
        "    line_color=\"LightSeaGreen\",\n",
