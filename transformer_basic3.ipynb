      "cell_type": "code",
      "source": [
        "def plot_positional_heatmap_plotly(num_tokens=50, d_model=64):\n",
        "    pe_mat = positional_encoding_matrix(num_tokens, d_model)\n",
        "    fig = px.imshow(\n",
        "        pe_mat,\n",
        "        color_continuous_scale=\"RdBu\",\n",
        "        labels=dict(x=\"Dimension\", y=\"Token Position\", color=\"Value (sin/cos)\"),\n",
        "        title=f\"Positional Encoding Heatmap (Tokens 0–{num_tokens-1}, {d_model} dims)\"\n",
        "    )\n",
        "    fig.update_layout(height=500, width=900)\n",
        "    fig.show()\n",
        "\n",
        "plot_positional_heatmap_plotly(num_tokens=20, d_model=10)"
      ],
