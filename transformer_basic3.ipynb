    {
      "cell_type": "code",
      "source": [
        "frequencies_to_compare = [3, 2, 1]\n",
        "num_rows = len(frequencies_to_compare)\n",
        "num_cols = 2\n",
        "\n",
        "x_range = 20\n",
        "num_points = 1000\n",
        "x = np.linspace(0, x_range, num_points)\n",
        "\n",
        "subplot_titles = []\n",
        "for freq in frequencies_to_compare:\n",
        "    subplot_titles.append(f'Sine Wave (Freq = {freq})')\n",
        "    subplot_titles.append(f'Cosine Wave (Freq = {freq})')\n",
        "\n",
        "# Create subplots\n",
        "fig = make_subplots(\n",
        "    rows=num_rows,\n",
        "    cols=num_cols,\n",
        "    subplot_titles=subplot_titles,\n",
        "    vertical_spacing=0.08,\n",
        "    horizontal_spacing=0.1\n",
        ")\n",
        "\n",
        "# Define colors for each frequency\n",
        "colors = ['#636EFA', '#EF553B', '#00CC96', '#AB63FA', '#FFA15A']\n",
        "\n",
        "# Generate and add sine and cosine waves for each frequency\n",
        "for i, freq in enumerate(frequencies_to_compare):\n",
        "    # Sine wave data (left column)\n",
        "    y_sin = np.sin(2 * np.pi * freq * (x / x_range))\n",
        "    fig.add_trace(\n",
        "        go.Scatter(\n",
        "            x=x,\n",
        "            y=y_sin,\n",
        "            mode='lines',\n",
        "            name=f'Sine Freq = {freq}',\n",
        "            line=dict(color=colors[i], width=2),\n",
        "            showlegend=False\n",
        "        ),\n",
        "        row=i + 1, col=1\n",
        "    )\n",
        "\n",
        "    # Cosine wave data (right column)\n",
        "    y_cos = np.cos(2 * np.pi * freq * (x / x_range))\n",
        "    fig.add_trace(\n",
        "        go.Scatter(\n",
        "            x=x,\n",
        "            y=y_cos,\n",
        "            mode='lines',\n",
        "            name=f'Cosine Freq = {freq}',\n",
        "            line=dict(color=colors[i], width=2),\n",
        "            showlegend=False\n",
        "        ),\n",
        "        row=i + 1, col=2\n",
        "    )\n",
        "\n",
        "fig.update_layout(\n",
        "    height=300 * num_rows,\n",
        "    title_text=\"Comparison of Sine and Cosine Waves with Different Frequencies\",\n",
        "    title_font_size=20,\n",
        "    showlegend=False\n",
        ")\n",
        "\n",
        "for i in range(num_rows):\n",
        "    # Left column (Sine)\n",
        "    fig.update_xaxes(\n",
        "        title_text=\"Token Position\",\n",
        "        range=[0, x_range],\n",
        "        gridcolor='lightgray',\n",
        "        row=i + 1,\n",
        "        col=1\n",
        "    )\n",
        "    fig.update_yaxes(\n",
        "        title_text=\"Amplitude\",\n",
        "        range=[-1.2, 1.2],\n",
        "        gridcolor='lightgray',\n",
        "        row=i + 1,\n",
        "        col=1\n",
        "    )\n",
        "\n",
        "    # Right column (Cosine)\n",
        "    fig.update_xaxes(\n",
        "        title_text=\"Position\",\n",
        "        range=[0, x_range],\n",
        "        gridcolor='lightgray',\n",
        "        row=i + 1,\n",
        "        col=2\n",
        "    )\n",
        "    fig.update_yaxes(\n",
        "        title_text=\"Amplitude\",\n",
        "        range=[-1.2, 1.2],\n",
        "        gridcolor='lightgray',\n",
        "        row=i + 1,\n",
        "        col=2\n",
        "    )\n",
        "\n",
        "fig.write_html('sine_cosine_waves_comparison.html')\n",
        "fig.show()"
      ],
