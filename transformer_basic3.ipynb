        "fig.update_layout(\n",
        "    title=\"Sine and Cosine Wave\",\n",
        "    xaxis_title=\"Time [s]\",\n",
        "    yaxis_title=\"Amplitude\",\n",
        ")\n",
        "\n",
        "fig.show()"
